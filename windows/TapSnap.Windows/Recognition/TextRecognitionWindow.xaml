<Window x:Class="TapSnap.Windows.TextRecognitionWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="识别结果" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="{DynamicResource Snap.Hover}" Foreground="{DynamicResource Snap.Foreground}" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="OcrCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Snap.Border}"/>
            <Setter Property="Background" Value="{DynamicResource Snap.Panel}"/>
        </Style>
        <Style x:Key="OcrIcon" TargetType="Button" BasedOn="{StaticResource SnapGhost}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource Snap.Hover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Snap.Muted}"/>
        </Style>
        <Style x:Key="OcrSegment" TargetType="RadioButton" BasedOn="{StaticResource SnapSegment}">
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="14" BorderBrush="{DynamicResource Snap.Border}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="51" Padding="12,0"
                    Background="{DynamicResource Snap.Panel}" BorderBrush="{DynamicResource Snap.Border}"
                    BorderThickness="0,0,0,1" CornerRadius="13,13,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource OcrIcon}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click" ToolTip="关闭识别结果 (Esc)" AutomationProperties.Name="关闭识别结果">
                        <Path Data="M2,2 L12,12 M2,12 L12,2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="CopyAll" DockPanel.Dock="Right" Style="{DynamicResource SnapPrimary}" Height="30"
                            Margin="0,0,8,0" IsEnabled="False" Click="CopyAll_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M5,4 H13 V13 H5Z M9,4 V1 H1 V10 H5"
                                  Stroke="{DynamicResource Snap.PrimaryForeground}" StrokeThickness="1.2" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CopyLabel" Text="复制全部" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" Background="{DynamicResource Snap.Hover}" CornerRadius="7">
                            <Path Data="M5,2 H2 V5 M11,2 H14 V5 M2,11 V14 H5 M14,11 V14 H11 M5,6 H11 M5,8 H11 M5,10 H9"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Snap.Foreground}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <TextBlock Text="识别结果" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="56*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource OcrCard}">
                    <ContentControl x:Name="OriginalHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OcrCard}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                            <Border x:Name="MarkdownModes" DockPanel.Dock="Right" Visibility="Collapsed" CornerRadius="7"
                                    Background="{DynamicResource Snap.Hover}" Padding="2" AutomationProperties.Name="Markdown 显示方式">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PreviewMode" Style="{StaticResource OcrSegment}" Content="预览" GroupName="MarkdownMode" IsChecked="True"/>
                                    <RadioButton x:Name="SourceMode" Style="{StaticResource OcrSegment}" Content="源码" GroupName="MarkdownMode"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Snap.Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,1,0"/>
                            <Border CornerRadius="7" Background="{DynamicResource Snap.Hover}" Padding="2" HorizontalAlignment="Left"
                                    AutomationProperties.Name="识别结果显示方式">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ParagraphMode" Style="{StaticResource OcrSegment}" Content="按段" GroupName="OcrMode" IsChecked="True"/>
                                    <RadioButton x:Name="LineMode" Style="{StaticResource OcrSegment}" Content="按原图行" GroupName="OcrMode"/>
                                    <RadioButton x:Name="MarkdownMode" Style="{StaticResource OcrSegment}" Content="Markdown" GroupName="OcrMode"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                        <Grid x:Name="SearchRow" DockPanel.Dock="Top" Margin="10,0,10,9">
                            <TextBox x:Name="Search" Height="26" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="搜索识别结果" ToolTip="搜索识别结果 (Ctrl+F)"/>
                            <TextBlock Text="搜索识别结果" Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Snap.Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Snap.Border}"/>
                        <Grid>
                            <ListBox x:Name="Rows" Padding="0" BorderThickness="0" Background="Transparent" IsTextSearchEnabled="False"
                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="识别文字列表">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Padding="12,10" BorderBrush="{DynamicResource Snap.Border}" BorderThickness="0,0,0,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Snap.Hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource OcrIcon}" VerticalAlignment="Top"
                                                    Click="CopyRow_Click" ToolTip="复制此段或行" AutomationProperties.Name="复制此段或行">
                                                <Path Data="M5,4 H13 V13 H5Z M9,4 V1 H1 V10 H5" Stroke="{DynamicResource Snap.Muted}" StrokeThickness="1.2"/>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource OcrIcon}" VerticalAlignment="Top"
                                                    Margin="5,0" Click="Locate_Click" ToolTip="在原图定位" AutomationProperties.Name="在原图定位">
                                                <Path Data="M13,7 A6,6 0 1 1 1,7 A6,6 0 1 1 13,7 M7,0 V4 M7,10 V14 M0,7 H4 M10,7 H14"
                                                      Stroke="{DynamicResource Snap.Muted}" StrokeThickness="1.2"/>
                                            </Button>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" IsReadOnly="True"
                                                     AcceptsReturn="True" VerticalAlignment="Center" Padding="0" BorderThickness="0">
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <AdornerDecorator x:Name="PART_ContentHost"/>
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                            </TextBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <FlowDocumentScrollViewer x:Name="MarkdownReader" IsToolBarVisible="False"
                                                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                                                      AutomationProperties.Name="Markdown 预览"/>
                            <TextBox x:Name="MarkdownEditor" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                                     AcceptsTab="True" BorderThickness="0" Padding="12,10" VerticalScrollBarVisibility="Auto"
                                     Visibility="Collapsed" AutomationProperties.Name="Markdown 源码"/>
                            <TextBlock x:Name="Hint" Text="识别中…" Margin="14" Foreground="{DynamicResource Snap.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
